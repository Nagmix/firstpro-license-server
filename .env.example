# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# License System
LICENSE_SECRET_KEY=your-64-char-secret-key-here
JWT_EXPIRY_DAYS=30
FREE_RECORD_LIMIT=500
MAX_DEVICES_PER_LICENSE=3

# Admin
ADMIN_EMAIL=admin@digitalplanetx.com
ADMIN_PASSWORD_HASH=your-bcrypt-hash

# Database
POSTGRES_URL=postgres://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
POSTGRES_URL_NON_POOLING=postgres://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres
